import {
  "cs6210501-lab/moonseek" @moonseek,
  "moonbitlang/core/json" @json,
  "moonbitlang/core/ref" @ref,
  "moonbitlang/core/debug" @debug,
}

pkgtype(kind: "foreign_library")

supported_targets = "+wasm-gc +js"

options(
  link: {
    "wasm-gc": {
      "use-js-builtin-string": true,
    },
    "js": {
      "format": "esm",
    },
  },
)